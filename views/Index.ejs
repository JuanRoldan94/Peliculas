<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Catalogo Peliculas</title>
    <link href="css/styles.css" rel="stylesheet">
</head>
<body>

    <h1>Mis peliculas</h1>

    <div id="lista-peliculas">
        
    </div>

    <button class="fab" onclick="abrirModal()">+</button>

    <div id="modal">
        <div class="modal-content">
            <h3>Agregar Nueva Pelicula</h3>
            <input type="text" id="nombre" placeholder="Nombre de la pelicula" >
            <input type="text" id="imagen" placeholder="URL de la imagen">
            <input type="text" id="genero" placeholder="Género">
            <div class="btn-group">
                <button type="button" class="save" onclick="guardarPelicula()">Guardar</button>
                <button type="button" class="cancel" onclick="cerrarModal()">Cancelar</button>
            </div>
        </div>
    </div>

    <script src="scripts/Scripts.js"></script>
</body>
</html>